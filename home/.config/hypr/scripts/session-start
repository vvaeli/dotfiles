#!/usr/bin/env bash
set -eu
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/md3-session-${UID}.lock"
flock -n 9 || exit 0
# Hyprland 0.56 runs this right after reading its config, before the Wayland socket and the
# monitors exist. Clients started that early crash with "Connection refused", so wait for both.
runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"
for _ in $(seq 300); do
    if [[ -z "${WAYLAND_DISPLAY:-}" || ! -S "$runtime/${WAYLAND_DISPLAY:-}" ]]; then
        socket="$(ls -t "$runtime"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n 1 || true)"
        if [[ -n "$socket" ]]; then export WAYLAND_DISPLAY="${socket##*/}"; fi
    fi
    if [[ -S "$runtime/${WAYLAND_DISPLAY:-}" ]] && [[ "$(hyprctl monitors -j 2>/dev/null)" == *'"name"'* ]]; then
        break
    fi
    sleep 0.1
done
# Xwayland comes up a moment later, and DISPLAY only reaches clients started after it. Without
# it apps launched from the shell (Steam) cannot open an X connection, so wait for it too.
for _ in $(seq 100); do
    if [[ -z "${DISPLAY:-}" ]]; then
        display="$(pgrep -u "$UID" -a Xwayland | grep -o ' :[0-9]\+' | head -n 1 | tr -d ' ' || true)"
        if [[ -n "$display" ]]; then export DISPLAY="$display"; fi
    fi
    [[ -n "${DISPLAY:-}" && -S "/tmp/.X11-unix/X${DISPLAY#:}" ]] && break
    sleep 0.1
done
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
mkdir -p "$state_dir"
# The shell's light/dark switch stores the mode; theme_sync.py keeps gsettings in step with it.
mode="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/md3/mode" 2>/dev/null || true)"
[[ "$mode" == light ]] || mode=dark
if [[ -e /usr/lib/qt6/plugins/platformthemes/libqt6ct.so ]]; then
    export QT_QPA_PLATFORMTHEME=qt6ct
else
    export QT_QPA_PLATFORMTHEME=xdgdesktopportal
fi
export QT_QUICK_CONTROLS_MATERIAL_THEME=${mode^}
export QT_QUICK_CONTROLS_UNIVERSAL_THEME=${mode^}
gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"
# Make portals and D-Bus activated applications inherit the Wayland session.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_MATERIAL_THEME QT_QUICK_CONTROLS_UNIVERSAL_THEME >/dev/null 2>&1 || true
start_once() {
    local process_name="$1"
    shift
    if ! pgrep -u "$UID" -x "$process_name" >/dev/null; then
        "$@" </dev/null >>"$state_dir/$process_name.log" 2>&1 9>&- &
    fi
}
# Portal services use D-Bus activation; start them after importing session variables.
systemctl --user reset-failed xdg-desktop-portal-gtk.service xdg-desktop-portal-hyprland.service xdg-desktop-portal.service >/dev/null 2>&1 || true
systemctl --user start --no-block xdg-desktop-portal-gtk.service xdg-desktop-portal-hyprland.service xdg-desktop-portal.service >/dev/null 2>&1 || true
start_once hyprpaper hyprpaper
if [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/md3/wallpaper.json" ]]; then
    python3 "$HOME/.config/quickshell/md3/wallpaper.py" restore >>"$state_dir/wallpaper.log" 2>&1 9>&- &
fi
start_once hypridle hypridle
systemctl --user start md3-rgb.service >>"$state_dir/rgb.log" 2>&1 || true

"$HOME/.config/hypr/scripts/clipboard-watch" </dev/null >>"$state_dir/clipboard.log" 2>&1 9>&- &
start_once hyprpolkitagent /usr/lib/hyprpolkitagent/hyprpolkitagent
"$HOME/.config/hypr/scripts/start-shell" </dev/null >>"$state_dir/quickshell.log" 2>&1 9>&- &
