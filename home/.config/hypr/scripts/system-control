#!/usr/bin/env python3
"""Run a multimedia key action, then display its actual state via shell IPC."""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys


COMMANDS = {
    'volume-up': ['wpctl', 'set-volume', '-l', '1', '@DEFAULT_AUDIO_SINK@', '5%+'],
    'volume-down': ['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', '5%-'],
    'volume-mute': ['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', 'toggle'],
    'mic-mute': ['wpctl', 'set-mute', '@DEFAULT_AUDIO_SOURCE@', 'toggle'],
    'brightness-up': ['brightnessctl', '-e4', '-n2', 'set', '5%+'],
    'brightness-down': ['brightnessctl', '-e4', '-n2', 'set', '5%-'],
}


def run(args):
    return subprocess.run(args, check=True, text=True, capture_output=True, timeout=5).stdout


def main():
    name = sys.argv[1] if len(sys.argv) > 1 else ''
    if name not in COMMANDS:
        return 2
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp'))
    with (runtime / f'md3-control-{os.getuid()}.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        run(COMMANDS[name])
        if name.startswith('brightness'):
            kind = 'brightness'
            level = int(run(['brightnessctl', 'get']).strip()) / max(1, int(run(['brightnessctl', 'max']).strip()))
            muted = False
        else:
            kind = 'microphone' if name == 'mic-mute' else 'volume'
            status = run(['wpctl', 'get-volume', '@DEFAULT_AUDIO_SOURCE@' if kind == 'microphone' else '@DEFAULT_AUDIO_SINK@'])
            match = re.search(r'Volume:\s*([0-9.]+)', status)
            if not match:
                raise RuntimeError('Не удалось прочитать громкость')
            level = float(match.group(1))
            muted = '[MUTED]' in status
        try:
            monitors = json.loads(run(['hyprctl', '-j', 'monitors']))
            monitor = next((m['name'] for m in monitors if m.get('focused')), 'DP-1')
        except (subprocess.SubprocessError, ValueError):
            monitor = 'DP-1'
        # The hardware action remains successful if the panel is hidden/stopped.
        subprocess.run(['qs', '-c', 'md3', 'ipc', 'call', 'osd', 'show', kind,
                        str(min(1, max(0, level))), 'true' if muted else 'false', monitor],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
