/* hyprland-share-picker in the md3 shell style. Generated by matugen from the wallpaper palette. */
QWidget { background-color: #231919; color: #f1dedd; font-family: "Adwaita Sans"; font-size: 14px; }
QLabel { background: transparent; }
QPushButton, QToolButton, QComboBox { background: #3d3231; color: #f1dedd; border: none; border-radius: 18px; padding: 8px 18px; }
QPushButton:hover, QToolButton:hover, QComboBox:hover { background: #5d3f3d; color: #ffdad7; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #ffb3ae; color: #571e1c; }
QPushButton:default { background: #ffb3ae; color: #571e1c; }
QLineEdit, QListView, QTreeView, QTableView, QAbstractScrollArea { background: #271d1c; border: none; border-radius: 14px; padding: 6px; selection-background-color: #5d3f3d; selection-color: #ffdad7; }
QListView::item, QTreeView::item { border-radius: 12px; padding: 6px; }
QListView::item:hover, QTreeView::item:hover { background: #3d3231; }
QListView::item:selected, QTreeView::item:selected { background: #5d3f3d; color: #ffdad7; }
QTabWidget::pane { border: none; background: #231919; }
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab { background: transparent; color: #d8c2bf; padding: 8px 18px; margin: 4px 4px 8px 0; border-radius: 18px; }
QTabBar::tab:hover { background: #3d3231; color: #f1dedd; }
QTabBar::tab:selected { background: #ffb3ae; color: #571e1c; }
QCheckBox { spacing: 10px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #a08c8a; border-radius: 6px; background: transparent; }
QCheckBox::indicator:checked { background: #ffb3ae; border-color: #ffb3ae; }
QMenu { background: #271d1c; border: none; border-radius: 14px; padding: 6px; }
QMenu::item { border-radius: 10px; padding: 6px 14px; }
QMenu::item:selected { background: #3d3231; }
QScrollBar { background: transparent; width: 8px; }
QScrollBar::handle { background: #534342; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QToolTip { background: #f1dedd; color: #382e2d; border: none; border-radius: 8px; padding: 4px 8px; }
