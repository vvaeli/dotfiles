/* hyprland-share-picker in the md3 shell style. Generated by matugen from the wallpaper palette. */
QWidget { background-color: {{colors.surface_container_low.default.hex}}; color: {{colors.on_surface.default.hex}}; font-family: "Adwaita Sans"; font-size: 14px; }
QLabel { background: transparent; }
QPushButton, QToolButton, QComboBox { background: {{colors.surface_container_highest.default.hex}}; color: {{colors.on_surface.default.hex}}; border: none; border-radius: 18px; padding: 8px 18px; }
QPushButton:hover, QToolButton:hover, QComboBox:hover { background: {{colors.secondary_container.default.hex}}; color: {{colors.on_secondary_container.default.hex}}; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: {{colors.primary.default.hex}}; color: {{colors.on_primary.default.hex}}; }
QPushButton:default { background: {{colors.primary.default.hex}}; color: {{colors.on_primary.default.hex}}; }
QLineEdit, QListView, QTreeView, QTableView, QAbstractScrollArea { background: {{colors.surface_container.default.hex}}; border: none; border-radius: 14px; padding: 6px; selection-background-color: {{colors.secondary_container.default.hex}}; selection-color: {{colors.on_secondary_container.default.hex}}; }
QListView::item, QTreeView::item { border-radius: 12px; padding: 6px; }
QListView::item:hover, QTreeView::item:hover { background: {{colors.surface_container_highest.default.hex}}; }
QListView::item:selected, QTreeView::item:selected { background: {{colors.secondary_container.default.hex}}; color: {{colors.on_secondary_container.default.hex}}; }
QTabWidget::pane { border: none; background: {{colors.surface_container_low.default.hex}}; }
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab { background: transparent; color: {{colors.on_surface_variant.default.hex}}; padding: 8px 18px; margin: 4px 4px 8px 0; border-radius: 18px; }
QTabBar::tab:hover { background: {{colors.surface_container_highest.default.hex}}; color: {{colors.on_surface.default.hex}}; }
QTabBar::tab:selected { background: {{colors.primary.default.hex}}; color: {{colors.on_primary.default.hex}}; }
QCheckBox { spacing: 10px; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid {{colors.outline.default.hex}}; border-radius: 6px; background: transparent; }
QCheckBox::indicator:checked { background: {{colors.primary.default.hex}}; border-color: {{colors.primary.default.hex}}; }
QMenu { background: {{colors.surface_container.default.hex}}; border: none; border-radius: 14px; padding: 6px; }
QMenu::item { border-radius: 10px; padding: 6px 14px; }
QMenu::item:selected { background: {{colors.surface_container_highest.default.hex}}; }
QScrollBar { background: transparent; width: 8px; }
QScrollBar::handle { background: {{colors.outline_variant.default.hex}}; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QToolTip { background: {{colors.inverse_surface.default.hex}}; color: {{colors.inverse_on_surface.default.hex}}; border: none; border-radius: 8px; padding: 4px 8px; }
